---
import { experience } from '../data/resume';
import { formatMonth, duration } from '../lib/dates';
---

<ol class="timeline">
  {
    experience.map((r) => (
      <li class:list={['role', { current: !r.end }]}>
        <div class="when">
          <span>{formatMonth(r.start)} – {r.end ? formatMonth(r.end) : 'Present'}</span>
          <span class="dur">{duration(r.start, r.end)}</span>
        </div>
        <div class="what">
          <h3>
            {r.title} <span class="at">at</span> {r.company}
          </h3>
          <p class="where">{r.location}</p>
          {r.summary && <p class="summary">{r.summary}</p>}
          {r.highlights && (
            <ul class="highlights">
              {r.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
          {r.clients && (
            <ul class="clients">
              {r.clients.map((c) => (
                <li>
                  <span class="label">Client</span> {c.name} · {formatMonth(c.start)} – {formatMonth(c.end)}
                </li>
              ))}
            </ul>
          )}
          {r.stack && (
            <p class="stack">
              {r.stack.map((s) => (
                <span class="chip">{s}</span>
              ))}
            </p>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .role {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1.5rem;
    padding-block: 1.5rem;
  }
  .role + .role {
    border-top: 1px dashed var(--rule);
  }
  .role:first-child {
    padding-top: 0;
  }
  .when {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
    padding-top: 0.35rem;
  }
  .dur {
    color: var(--ink-3);
  }
  .current .when span:first-child::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    vertical-align: 0.05em;
  }
  h3 {
    font-size: 1.6rem;
  }
  .at {
    font-style: italic;
    color: var(--ink-3);
  }
  .where {
    font-size: 0.875rem;
    color: var(--ink-3);
    margin: 0.25rem 0 0.75rem;
  }
  .summary {
    color: var(--ink-2);
  }
  .highlights {
    margin: 0 0 0.75rem;
    padding-left: 1.1rem;
    color: var(--ink-2);
  }
  .highlights li {
    margin-bottom: 0.3rem;
  }
  .highlights li::marker {
    color: var(--accent);
  }
  .clients {
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }
  @media (max-width: 560px) {
    .role {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .when {
      flex-direction: row;
      gap: 0.75rem;
      padding-top: 0;
    }
  }
</style>

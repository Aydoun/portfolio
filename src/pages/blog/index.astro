---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { formatDate } from '../../lib/dates';

const posts = await getPosts();
---

<Base title="Writing" description="Notes on frontend engineering, leadership and building for the web.">
  <div class="wrap page">
    <p class="label">Writing</p>
    <h1>Notes on frontend, leadership and <em>building for the web</em>.</h1>
    {
      posts.length === 0 ? (
        <p class="empty">Nothing published yet. The first posts are on their way.</p>
      ) : (
        <ul class="posts">
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.id}/`}>
                <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                <span class="t">
                  {p.data.title}
                  {p.data.draft && <span class="chip">draft</span>}
                </span>
                <span class="d">{p.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .page {
    padding-block: clamp(3rem, 8vw, 5rem) 3rem;
  }
  h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.75rem);
    max-width: 18ch;
    margin: 1.25rem 0 3rem;
  }
  h1 em {
    color: var(--accent);
  }
  .empty {
    color: var(--ink-3);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .posts a {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    column-gap: 1.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  time {
    grid-row: span 2;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-3);
    padding-top: 0.4rem;
  }
  .t {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.2;
  }
  .t .chip {
    margin-left: 0.5rem;
    vertical-align: middle;
    font-family: var(--font-mono);
  }
  .d {
    color: var(--ink-2);
  }
  @media (max-width: 560px) {
    .posts a {
      grid-template-columns: 1fr;
    }
    time {
      grid-row: auto;
    }
  }
</style>

---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { formatDate } from '../../lib/dates';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="wrap post">
    <a class="back label" href="/blog/">← All writing</a>
    <header>
      <time class="label" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <h1>{post.data.title}</h1>
      <p class="desc">{post.data.description}</p>
    </header>
    <div class="body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    padding-block: 3rem;
  }
  .back {
    text-decoration: none;
  }
  header {
    margin: 2.5rem 0;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    margin: 0.75rem 0 1rem;
  }
  .desc {
    font-size: 1.1875rem;
    color: var(--ink-2);
  }
  .body {
    font-size: 1.125rem;
  }
  .body :global(h2) {
    font-size: 2rem;
    margin: 2.5rem 0 1rem;
  }
  .body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    background: var(--paper-2);
    border-radius: 4px;
  }
  .body :global(pre) {
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    font-size: 0.875rem;
  }
  .body :global(pre code) {
    padding: 0;
    background: none;
  }
  .body :global(li::marker) {
    color: var(--accent);
  }
</style>

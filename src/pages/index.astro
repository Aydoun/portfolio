---
import Base from '../layouts/Base.astro';
import Experience from '../components/Experience.astro';
import {
  profile,
  stats,
  skills,
  languages,
  education,
  certifications,
} from '../data/resume';
---

<Base>
  <section class="hero wrap">
    <div class="hero-top">
      <div class="intro">
        <p class="label status"><span class="dot"></span>{profile.role} at {profile.company} · {profile.location}</p>
        <h1>
          Hi, I’m {profile.shortName}.<br />
          <em>I build and lead frontend</em> for large web products.
        </h1>
        <p class="lede">
          More than ten years in the JavaScript ecosystem, from full-stack startup work in Shenzhen to leading
          frontend teams in the Netherlands.
        </p>
        <div class="cta">
          <a class="btn primary" href={`mailto:${profile.email}`}>Get in touch</a>
          <a class="btn" href={profile.linkedin} target="_blank" rel="me noopener">LinkedIn ↗</a>
        </div>
      </div>
      <figure class="portrait">
        {
          profile.photo ? (
            <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="800" height="1028" fetchpriority="high" />
          ) : (
            <div class="portrait-placeholder" role="img" aria-label="Profile photo placeholder">
              <span class="initials" aria-hidden="true">MA</span>
              <span class="label">Photo coming soon</span>
            </div>
          )
        }
      </figure>
    </div>
    <dl class="stats">
      {
        stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <div class="wrap">
    <section class="section" id="about">
      <h2 class="label">About</h2>
      <div class="prose">
        {profile.about.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="section" id="experience">
      <h2 class="label">Experience</h2>
      <Experience />
    </section>

    <section class="section" id="skills">
      <h2 class="label">Skills</h2>
      <div class="skills">
        {
          skills.map((g) => (
            <div>
              <h3>{g.group}</h3>
              <p>
                {g.items.map((i) => (
                  <span class="chip">{i}</span>
                ))}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" id="languages">
      <h2 class="label">Languages</h2>
      <ul class="langs">
        {
          languages.map((l) => (
            <li>
              <span class="hello" dir={l.dir ?? 'ltr'} lang={l.code}>
                {l.hello}
              </span>
              <span class="lname">{l.name}</span>
              <span class="lvl">{l.level}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" id="education">
      <h2 class="label">Education</h2>
      <div>
        <ul class="edu">
          {
            education.map((e) => (
              <li>
                <span class="years">{e.years}</span>
                <div>
                  <h3>{e.degree}</h3>
                  <p>{e.school}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <h3 class="certs-title">Certifications</h3>
        <ul class="certs">
          {certifications.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <section class="section contact" id="contact">
      <h2 class="label">Contact</h2>
      <div>
        <p class="big">
          Have a team, a product or a hard frontend problem? <a href={`mailto:${profile.email}`}>Let’s talk.</a>
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 10vw, 7rem) 4rem;
  }
  .hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(14rem, 26vw, 19rem);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }
  .portrait {
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--paper-2);
    transform: rotate(1.5deg);
    box-shadow: 0 1px 0 var(--rule), 0 24px 48px -28px rgb(0 0 0 / 0.35);
    transition: transform 0.3s ease;
  }
  .portrait:hover {
    transform: rotate(0deg);
  }
  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portrait-placeholder {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    background:
      radial-gradient(circle at 30% 20%, var(--accent-soft), transparent 60%),
      repeating-linear-gradient(-45deg, transparent 0 10px, var(--accent-soft) 10px 11px);
  }
  .initials {
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 6.5rem);
    line-height: 1;
    color: var(--ink-2);
  }
  .portrait-placeholder .label {
    position: absolute;
    bottom: 1rem;
    left: 0;
    right: 0;
    text-align: center;
  }
  @media (max-width: 720px) {
    .hero-top {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .portrait {
      order: -1;
      width: 7.5rem;
      margin-bottom: 2rem;
      aspect-ratio: 1;
      border-radius: 50%;
      transform: none;
    }
    .initials {
      font-size: 2.75rem;
    }
    .portrait-placeholder .label {
      display: none;
    }
  }
  .status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    flex: none;
  }
  h1 {
    font-size: clamp(2.6rem, 7.5vw, 5.5rem);
    line-height: 1.02;
    max-width: 16ch;
  }
  h1 em {
    color: var(--accent);
  }
  .lede {
    max-width: 38rem;
    margin-top: 1.75rem;
    font-size: 1.1875rem;
    color: var(--ink-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn.primary {
    background: var(--ink);
    color: var(--paper);
  }
  .btn.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 4rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 1;
  }
  .stats dt {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    color: var(--ink-3);
    max-width: 14rem;
  }
  @media (max-width: 560px) {
    .stats {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .prose {
    max-width: var(--measure);
    font-size: 1.1875rem;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem;
  }
  .skills h3,
  .certs-title {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
  }
  .skills p {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .langs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .langs li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1.25rem;
    background: var(--paper);
    transition: background-color 0.15s ease;
  }
  .langs li:hover {
    background: var(--paper-2);
  }
  .hello {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.2;
    text-align: left;
  }
  .lname {
    font-weight: 500;
  }
  .lvl {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .edu {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
  }
  .edu li {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }
  .edu li + li {
    border-top: 1px dashed var(--rule);
  }
  .years {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
    padding-top: 0.3rem;
  }
  .edu h3 {
    font-size: 1.35rem;
  }
  .edu p {
    margin: 0.2rem 0 0;
    color: var(--ink-3);
    font-size: 0.9375rem;
  }
  @media (max-width: 560px) {
    .edu li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
  .certs {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-2);
    columns: 2 16rem;
  }
  .certs li::marker {
    color: var(--accent);
  }

  .big {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    line-height: 1.15;
    max-width: 22ch;
  }
  .big a {
    color: var(--accent);
    font-style: italic;
  }
</style>
